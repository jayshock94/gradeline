# Copy to .env.local for local development. On Vercel, add these as Environment Variables.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server only (Vercel): a send-only Resend key for team invite emails. Never prefix this with VITE_.
RESEND_API_KEY=
